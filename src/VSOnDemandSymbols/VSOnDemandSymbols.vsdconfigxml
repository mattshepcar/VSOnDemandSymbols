<?xml version="1.0" encoding="utf-8"?>
<Configuration xmlns="http://schemas.microsoft.com/vstudio/vsdconfig/2008">
  <!--
    IDE-side Concord component (ComponentLevel = 210000 > RemotingBoundary 100000,
    and < BreakpointManager 228441 so OnModuleInstanceLoad loads symbols before
    BreakpointManager binds breakpoints on module load).
  -->
  <ManagedComponent
    ComponentId="8e4a9c21-5f73-4d18-9a3b-62e1f0c4d802"
    ComponentLevel="210000"
    AssemblyName="VSOnDemandSymbols">

    <Class Name="VSOnDemandSymbols.Debugger.ConcordSymbolMonitor">
      <Implements>
        <InterfaceGroup>
          <Filter>
            <RuntimeId RequiredValue="DkmRuntimeId.Native" />
          </Filter>
          <Interface Name="IDkmModuleInstanceLoadNotification" />
          <Interface Name="IDkmModuleInstanceUnloadNotification" />
          <Interface Name="IDkmModuleSymbolsLoadedNotification" />
        </InterfaceGroup>

        <!--
          D-19: Do NOT implement IDkmBreakpointManagerNotification here. It is consumed by the AD7
          abstraction layer to raise IDebugBreakpointBoundEvent2 to the IDE; implementing it in this
          component stopped breakpoint glyphs from updating after a deferred bind. Breakpoint errors
          are observed through IVsDebugger.AdviseDebugEventCallback instead (Ad7BreakpointEventListener).
        -->
        <InterfaceGroup>
          <Filter>
            <EngineId RequiredValue="DkmEngineId.NativeEng" />
            <EngineId RequiredValue="DkmEngineId.COMPlusNativeEng" />
          </Filter>
          <Interface Name="IDkmProcessExitNotification" />
        </InterfaceGroup>
      </Implements>
    </Class>

  </ManagedComponent>
</Configuration>

